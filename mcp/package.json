{
  "name": "category-a-quiz-mcp",
  "version": "1.0.0",
  "description": "MCP connector for Category A Finland motorcycle theory quiz (Licence Coach)",
  "type": "module",
  "main": "server.js",
  "bin": {
    "category-a-quiz-mcp": "./server.js"
  },
  "scripts": {
    "start": "node server.js",
    "test-tools": "node --input-type=module -e \"import('./lib/quiz.js').then(async m=>{const q=await m.createQuizEngine(); console.log(JSON.stringify(q.dueCount(),null,2)); console.log(JSON.stringify(q.stats(),null,2));})\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  }
}
